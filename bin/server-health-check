#!/usr/bin/env bash

set -u
set -o pipefail

show_help() {
    cat <<'HELP'
Usage: server-health-check <command> [options]

Commands:
  init-config
             Create /etc/server-health-check.conf from the example configuration.
             Requires root. Existing paths are never overwritten.
  validate-config
             Check configuration ownership, permissions, and values.
             Requires root. Does not modify files or send email.
  test-email Send a test email using the configured Mailgun account.
             Requires root. Does not run health checks.
  check-reboot
             Check reboot status and print the result. Requires root.
             Currently checks only the reboot-required marker. Does not send email.

Options:
  -h, --help Show this help message.
  --without-sending
             Print email subjects and bodies instead of sending.
             Other command actions still run.

Exit codes:
  0  Success; no action required for the checks performed.
  1  Operation failed or check result unknown.
  2  Invalid command or options.
  3  Check completed; maintenance action required.
HELP
}

main() {
    local script_path project_directory
    local command_name='' argument
    # Runtime mode shared by every email delivery call.
    SHC_WITHOUT_SENDING=false
    # Resolve symlinks before locating the project's libraries and template.
    script_path=$(realpath -- "${BASH_SOURCE[0]}") || return 1
    project_directory=$(cd -- "$(dirname -- "$script_path")/.." && pwd -P) || return 1

    # Load application code only; configuration files are never sourced.
    # shellcheck source=lib/logging.sh
    source "$project_directory/lib/logging.sh" || return 1

    for argument in "$@"; do
        case $argument in
            --without-sending)
                SHC_WITHOUT_SENDING=true
                ;;
            -h|--help)
                show_help
                return
                ;;
            -*)
                log_error 'invalid options. Use --help for usage.'
                return 2
                ;;
            *)
                if [[ -n $command_name || -z $argument ]]; then
                    log_error 'expected one command. Use --help for usage.'
                    return 2
                fi
                command_name=$argument
                ;;
        esac
    done

    case $command_name in
        '')
            show_help
            ;;
        init-config|validate-config|test-email|check-reboot)
            if (( EUID != 0 )); then
                log_error 'this command must be run as root.'
                return 1
            fi

            case $command_name in
                check-reboot)
                    # shellcheck source=lib/checks/reboot.sh
                    source "$project_directory/lib/checks/reboot.sh" || return 1
                    printf 'Checks performed: reboot status only\n'
                    check_reboot
                    ;;
                init-config)
                    # shellcheck source=lib/init.sh
                    source "$project_directory/lib/init.sh" || return 1
                    init_config "$project_directory/config/config.example" /etc/server-health-check.conf
                    ;;
                validate-config|test-email)
                    # shellcheck source=lib/config.sh
                    source "$project_directory/lib/config.sh" || return 1
                    load_config /etc/server-health-check.conf || return 1
                    if [[ $command_name == validate-config ]]; then
                        printf 'Configuration is valid.\n'
                    else
                        # shellcheck source=lib/mailgun.sh
                        source "$project_directory/lib/mailgun.sh" || return 1
                        send_test_email
                    fi
                    ;;
            esac
            ;;
        *)
            log_error 'unknown command. Use --help for usage.'
            return 2
            ;;
    esac
}

main "$@"
